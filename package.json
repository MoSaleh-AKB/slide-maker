{
  "name": "slide-maker",
  "version": "1.0.0",
  "description": "🎯 Universal Slide Maker - Create professional presentations from Markdown/JSON with AI-powered images, RTL support, and beautiful themes",
  "main": "src/index.js",
  "bin": {
    "slide-maker": "./cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "node cli.js",
    "build": "node cli.js build",
    "test": "node --test tests/",
    "example:simple": "node cli.js build examples/simple-english.md -o output/simple.pptx",
    "example:persian": "node cli.js build examples/persian-rtl.md -o output/persian.pptx --direction rtl"
  },
  "keywords": [
    "presentation",
    "powerpoint",
    "pptx",
    "slides",
    "markdown",
    "rtl",
    "persian",
    "arabic",
    "ai",
    "gemini",
    "unsplash"
  ],
  "author": "MoSaleh-AKB",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "mustache": "^4.2.0",
    "ora": "^8.0.1",
    "pptxgenjs": "^3.12.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MoSaleh-AKB/slide-maker.git"
  }
}
